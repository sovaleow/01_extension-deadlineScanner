{
  "name": "EduAlert",
  "description": "Scans important deadline on a webpage into Google Calendar",
  "version": "1.0",
  "manifest_version": 3,
  "action": {
    "default_popup": "popup.html"
  },
  "permissions": [
    "storage", "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts":[
    {
        "matches": ["<all_urls>"],
        "js": ["content.js"]
    }
  ]
}